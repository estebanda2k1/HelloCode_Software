<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="mainPane" prefHeight="852.0" prefWidth="393.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Gamificacion_Modulo.GUI.RankingController">
   <children>
      <!-- Header Navigation -->
      <HBox alignment="CENTER" layoutX="0.0" layoutY="765.0" prefHeight="87.0" prefWidth="393.0" style="-fx-background-color: #ffffff; -fx-border-color: #000000; -fx-border-width: 1px;">
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false" onAction="#onHomeClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Home" />
            <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#onProfileClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Perfil" />
            <Button fx:id="btnRanking" mnemonicParsing="false" onAction="#onRankingClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Ranking" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
      
      <!-- Ranking Content -->
      <VBox alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefHeight="700.0" prefWidth="353.0" spacing="20.0">
         <children>
            <!-- Title -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Ranking de Estudiantes" />
            
            <!-- Filter Options -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <ToggleGroup fx:id="toggleGroupFiltro" />
                  <RadioButton fx:id="rbSemanal" mnemonicParsing="false" onAction="#onFiltroSemanalClicked" selected="true" text="Semanal" toggleGroup="$toggleGroupFiltro" />
                  <RadioButton fx:id="rbMensual" mnemonicParsing="false" onAction="#onFiltroMensualClicked" text="Mensual" toggleGroup="$toggleGroupFiltro" />
                  <RadioButton fx:id="rbGeneral" mnemonicParsing="false" onAction="#onFiltroGeneralClicked" text="General" toggleGroup="$toggleGroupFiltro" />
               </children>
            </HBox>
            
            <!-- Top 3 Podium -->
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Top 3" />
                  <HBox alignment="CENTER" spacing="30.0">
                     <children>
                        <!-- Second Place -->
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #C0C0C0;" text="2°" />
                              <Circle fx:id="avatar2" fill="#E0E0E0" radius="30.0" />
                              <Label fx:id="lblNombre2" style="-fx-font-size: 14px;" text="Usuario 2" />
                              <Label fx:id="lblPuntos2" style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="8500 pts" />
                           </children>
                        </VBox>
                        
                        <!-- First Place -->
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FFD700;" text="1°" />
                              <Circle fx:id="avatar1" fill="#FFD700" radius="40.0" />
                              <Label fx:id="lblNombre1" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Usuario 1" />
                              <Label fx:id="lblPuntos1" style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="15000 pts" />
                           </children>
                        </VBox>
                        
                        <!-- Third Place -->
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #CD7F32;" text="3°" />
                              <Circle fx:id="avatar3" fill="#CD7F32" radius="30.0" />
                              <Label fx:id="lblNombre3" style="-fx-font-size: 14px;" text="Usuario 3" />
                              <Label fx:id="lblPuntos3" style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="7200 pts" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Ranking List -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Ranking Completo" />
                  <ListView fx:id="lvRanking" prefHeight="300.0" prefWidth="300.0" style="-fx-background-color: #f5f5f5;">
                     <cellFactory>
                        <RankingCellFactory />
                     </cellFactory>
                  </ListView>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
