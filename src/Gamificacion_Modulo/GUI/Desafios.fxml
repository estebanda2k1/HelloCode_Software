<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="mainPane" prefHeight="852.0" prefWidth="393.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Gamificacion_Modulo.GUI.DesafiosController">
   <children>
      <!-- Header Navigation -->
      <HBox alignment="CENTER" layoutX="0.0" layoutY="765.0" prefHeight="87.0" prefWidth="393.0" style="-fx-background-color: #ffffff; -fx-border-color: #000000; -fx-border-width: 1px;">
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false" onAction="#onHomeClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Home" />
            <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#onProfileClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Perfil" />
            <Button fx:id="btnRanking" mnemonicParsing="false" onAction="#onRankingClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Ranking" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
      
      <!-- Challenges Content -->
      <VBox alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefHeight="700.0" prefWidth="353.0" spacing="20.0">
         <children>
            <!-- Title -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Desafíos" />
            
            <!-- Filter Tabs -->
            <TabPane fx:id="tabPane" prefHeight="600.0" prefWidth="353.0" tabClosingPolicy="UNAVAILABLE">
               <tabs>
                  <!-- Weekly Challenges Tab -->
                  <Tab fx:id="tabSemanales" text="Semanales">
                     <content>
                        <VBox alignment="TOP_CENTER" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Desafíos Semanales" />
                              <ScrollPane fx:id="scrollSemanales" fitToWidth="true" prefHeight="500.0">
                                 <content>
                                    <VBox fx:id="vboxSemanales" spacing="10.0">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
                  
                  <!-- Monthly Challenges Tab -->
                  <Tab fx:id="tabMensuales" text="Mensuales">
                     <content>
                        <VBox alignment="TOP_CENTER" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Desafíos Mensuales" />
                              <ScrollPane fx:id="scrollMensuales" fitToWidth="true" prefHeight="500.0">
                                 <content>
                                    <VBox fx:id="vboxMensuales" spacing="10.0">
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
