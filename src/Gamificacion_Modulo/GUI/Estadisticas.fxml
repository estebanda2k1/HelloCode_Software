<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>

<AnchorPane fx:id="mainPane" prefHeight="852.0" prefWidth="393.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Gamificacion_Modulo.GUI.EstadisticasController">
   <children>
      <!-- Header Navigation -->
      <HBox alignment="CENTER" layoutX="0.0" layoutY="765.0" prefHeight="87.0" prefWidth="393.0" style="-fx-background-color: #ffffff; -fx-border-color: #000000; -fx-border-width: 1px;">
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false" onAction="#onHomeClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Home" />
            <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#onProfileClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Perfil" />
            <Button fx:id="btnRanking" mnemonicParsing="false" onAction="#onRankingClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Ranking" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
      
      <!-- Statistics Content -->
      <ScrollPane fx:id="scrollEstadisticas" fitToWidth="true" layoutX="0.0" layoutY="0.0" prefHeight="765.0" prefWidth="393.0">
         <content>
            <VBox alignment="TOP_CENTER" spacing="20.0">
               <children>
                  <!-- Title -->
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Estadísticas de Progreso" />
                  
                  <!-- Quick Stats Cards -->
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #4CAF50; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="14602" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="EXP Total" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #2196F3; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="37" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="Desafíos" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #FF9800; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="3" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="Logros" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <!-- Progress Chart -->
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Progreso Semanal" />
                        <LineChart fx:id="chartProgreso" prefHeight="200.0" prefWidth="350.0">
                           <xAxis>
                              <CategoryAxis side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis side="LEFT" />
                           </yAxis>
                        </LineChart>
                     </children>
                  </VBox>
                  
                  <!-- Activity Heatmap -->
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Actividad Diaria" />
                        <GridPane fx:id="gridActividad" alignment="CENTER" hgap="5.0" vgap="5.0">
                           <!-- Will be populated dynamically -->
                        </GridPane>
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label style="-fx-font-size: 12px;" text="Menos" />
                              <Rectangle fill="#EBEDF0" height="12.0" width="12.0" />
                              <Rectangle fill="#C6E48B" height="12.0" width="12.0" />
                              <Rectangle fill="#7BC96F" height="12.0" width="12.0" />
                              <Rectangle fill="#239A3B" height="12.0" width="12.0" />
                              <Rectangle fill="#196127" height="12.0" width="12.0" />
                              <Label style="-fx-font-size: 12px;" text="Más" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Detailed Stats -->
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Estadísticas Detalladas" />
                        
                        <!-- Weekly Stats -->
                        <VBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Esta Semana" />
                              <HBox alignment="CENTER_LEFT" spacing="20.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblExpSemanal" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="1250" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="EXP ganados" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblDesafiosSemanal" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="14" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Desafíos completados" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <!-- Monthly Stats -->
                        <VBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Este Mes" />
                              <HBox alignment="CENTER_LEFT" spacing="20.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblExpMensual" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="5420" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="EXP ganados" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblDesafiosMensual" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="23" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Desafíos completados" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <!-- Streak Info -->
                        <VBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Racha de Estudio" />
                              <HBox alignment="CENTER_LEFT" spacing="20.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblRachaActual" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="7" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Días actuales" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="5.0">
                                       <children>
                                          <Label fx:id="lblRachaMaxima" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="15" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Máximo histórico" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
