<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="mainPane" prefHeight="852.0" prefWidth="393.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Gamificacion_Modulo.GUI.LogrosController">
   <children>
      <!-- Header Navigation -->
      <HBox alignment="CENTER" layoutX="0.0" layoutY="765.0" prefHeight="87.0" prefWidth="393.0" style="-fx-background-color: #ffffff; -fx-border-color: #000000; -fx-border-width: 1px;">
         <children>
            <Button fx:id="btnHome" mnemonicParsing="false" onAction="#onHomeClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Home" />
            <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#onProfileClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Perfil" />
            <Button fx:id="btnRanking" mnemonicParsing="false" onAction="#onRankingClicked" prefHeight="58.0" prefWidth="64.0" style="-fx-background-color: #ffffff;" text="Ranking" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
      
      <!-- Achievements Content -->
      <VBox alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefHeight="700.0" prefWidth="353.0" spacing="20.0">
         <children>
            <!-- Title -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Mis Logros" />
            
            <!-- Achievement Stats -->
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label fx:id="lblLogrosObtenidos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="3" />
                        <Label style="-fx-font-size: 14px;" text="Obtenidos" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label fx:id="lblLogrosTotales" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #666666;" text="10" />
                        <Label style="-fx-font-size: 14px;" text="Total" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Progress Bar -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label style="-fx-font-size: 16px;" text="Progreso General" />
                  <ProgressBar fx:id="progressGeneral" prefWidth="300.0" progress="0.3" />
                  <Label fx:id="lblPorcentajeProgreso" style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="30% completado" />
               </children>
            </VBox>
            
            <!-- Achievements Grid -->
            <ScrollPane fx:id="scrollLogros" fitToWidth="true" prefHeight="400.0">
               <content>
                  <TilePane fx:id="tileLogros" alignment="CENTER" hgap="20.0" prefColumns="2" vgap="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     
                     <!-- Achievement Card Template (will be populated dynamically) -->
                     <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <children>
                           <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@assets/logro_principiante.png" />
                              </image>
                           </ImageView>
                           <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Principiante" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-text-alignment: center;" text="Completa tu primera lección" wrapText="true" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="✓ Obtenido" />
                        </children>
                     </VBox>
                     
                     <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <children>
                           <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@assets/logro_dedicado.png" />
                              </image>
                           </ImageView>
                           <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Dedicado" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-text-alignment: center;" text="Estudia 7 días seguidos" wrapText="true" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="✓ Obtenido" />
                        </children>
                     </VBox>
                     
                     <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <children>
                           <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@assets/logro_acumulador.png" />
                              </image>
                           </ImageView>
                           <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Acumulador" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-text-alignment: center;" text="Obtén 10,000 puntos" wrapText="true" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="✓ Obtenido" />
                        </children>
                     </VBox>
                     
                     <!-- Locked Achievement Example -->
                     <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #e0e0e0; -fx-padding: 15; -fx-background-radius: 10; -fx-opacity: 0.6;">
                        <children>
                           <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@assets/logro_locked.png" />
                              </image>
                           </ImageView>
                           <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Maestro" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-text-alignment: center;" text="Completa 50 lecciones" wrapText="true" />
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #999999;" text="🔒 Bloqueado" />
                        </children>
                     </VBox>
                  </TilePane>
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
